---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  kep: ImageMetadata;
  kepLeiras: string;
  galeria: { kep: ImageMetadata; leiras: string }[];
  sizes?: string;
}

const { kep, kepLeiras, galeria, sizes = '(max-width: 900px) 100vw, 60vw' } = Astro.props;

const NAGY_KEP_SZELESSEG = 2400;

const kepek = await Promise.all(
  [{ kep, leiras: kepLeiras }, ...galeria].map(async (k) => ({
    ...k,
    nagy: (await getImage({ src: k.kep, width: Math.min(k.kep.width, NAGY_KEP_SZELESSEG), format: 'webp' })).src,
  })),
);
---

<div class="galeria">
  <div class="galeria__ablak">
    {
      kepek.map((k) => (
        <a class="galeria__dia" href={k.nagy} aria-label={`Nagyítás: ${k.leiras}`}>
          <Image src={k.kep} alt={k.leiras} widths={[600, 1000, 1400]} sizes={sizes} />
        </a>
      ))
    }
  </div>
  {
    kepek.length > 1 && (
      <div class="galeria__kicsik" role="group" aria-label="Képek">
        {kepek.map((k, i) => (
          <button type="button" aria-label={k.leiras} aria-current={i === 0 ? 'true' : undefined}>
            <Image src={k.kep} alt="" widths={[300, 500]} sizes="(max-width: 900px) 25vw, 15vw" />
          </button>
        ))}
      </div>
    )
  }
  <dialog class="galeria__modal" aria-label="Nagyított kép">
    <button type="button" class="galeria__bezar" aria-label="Bezárás">×</button>
    <img alt="" />
  </dialog>
</div>

<script>
  // A diák egy vízszintesen görgethető sávban vannak: a böngésző görgetése adja a csúszó effektet és az ujjal lapozást.
  // JavaScript nélkül a sáv így is lapozható, a főkép linkje pedig megnyitja a nagy képet.
  const BETOLTESRE_VAR_MS = 400;

  document.querySelectorAll<HTMLElement>('.galeria').forEach((galeria) => {
    const ablak = galeria.querySelector<HTMLElement>('.galeria__ablak')!;
    const diak = [...ablak.querySelectorAll<HTMLAnchorElement>('.galeria__dia')];
    const kicsik = [...galeria.querySelectorAll<HTMLButtonElement>('.galeria__kicsik button')];
    const modal = galeria.querySelector<HTMLDialogElement>('.galeria__modal')!;
    const modalKep = modal.querySelector('img')!;

    let aktiv = 0;
    // Kattintásnál a célkép: amíg a sáv odaér, a közbülső képek nem kapnak kijelölést.
    let cel: number | null = null;

    function kijelol(i: number) {
      aktiv = i;
      diak.forEach((d, j) => (d.tabIndex = j === i ? 0 : -1));
      kicsik.forEach((k, j) => (j === i ? k.setAttribute('aria-current', 'true') : k.removeAttribute('aria-current')));
    }

    async function lapoz(i: number) {
      if (i === aktiv) return;
      cel = i;
      kijelol(i);
      // Ne üres kép csússzon be: a lusta betöltésű célképet megvárjuk, de nem sokáig.
      const kep = diak[i].querySelector('img')!;
      kep.loading = 'eager';
      await Promise.race([kep.decode().catch(() => {}), new Promise((ok) => setTimeout(ok, BETOLTESRE_VAR_MS))]);
      if (cel !== i) return;
      const sima = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      ablak.scrollTo({ left: i * ablak.clientWidth, behavior: sima ? 'smooth' : 'auto' });
    }

    ablak.addEventListener(
      'scroll',
      () => {
        if (!ablak.clientWidth) return;
        const i = Math.round(ablak.scrollLeft / ablak.clientWidth);
        if (cel !== null) {
          if (i === cel) cel = null;
          return;
        }
        if (i !== aktiv) kijelol(i);
      },
      { passive: true },
    );
    for (const esemeny of ['touchstart', 'wheel']) {
      ablak.addEventListener(esemeny, () => (cel = null), { passive: true });
    }

    // Ablakméret-váltáskor és a Konyhák szűrő után (a rejtett elem elveszítheti a görgetést) visszaáll a pozíció.
    new ResizeObserver(() => {
      if (ablak.clientWidth) ablak.scrollLeft = aktiv * ablak.clientWidth;
    }).observe(ablak);

    kicsik.forEach((kicsi, i) => kicsi.addEventListener('click', () => lapoz(i)));

    diak.forEach((dia) => {
      dia.addEventListener('click', (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;
        e.preventDefault();
        modalKep.src = dia.href;
        modalKep.alt = dia.querySelector('img')!.alt;
        modal.showModal();
      });
    });

    modal.querySelector('.galeria__bezar')!.addEventListener('click', () => modal.close());
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
    modal.addEventListener('close', () => {
      modalKep.removeAttribute('src');
      diak[aktiv].focus({ preventScroll: true });
    });

    kijelol(0);
  });
</script>

<style>
  .galeria {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .galeria__ablak {
    display: flex;
    aspect-ratio: 3 / 2;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background: var(--tahini);
  }
  .galeria__ablak::-webkit-scrollbar {
    display: none;
  }
  .galeria__dia {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    cursor: zoom-in;
  }
  .galeria__dia img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .galeria__kicsik {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .galeria__kicsik button {
    padding: 0;
    border: 0;
    background: var(--tahini);
    cursor: pointer;
  }
  .galeria__kicsik button:hover img {
    opacity: 0.85;
  }
  .galeria__kicsik button[aria-current] {
    box-shadow: 0 0 0 2px var(--dark-blueberry);
  }
  .galeria__kicsik img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .galeria__modal {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: 0;
    background: rgb(0 0 0 / 0.92);
  }
  .galeria__modal[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .galeria__modal img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .galeria__bezar {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: var(--feher);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
  }

  :global(html:has(.galeria__modal[open])) {
    overflow: hidden;
  }
</style>
