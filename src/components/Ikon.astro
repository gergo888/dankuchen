---
interface Props {
  nev: 'terv' | 'szallitas' | 'szereles' | 'terkep';
  meret?: number;
}

const { nev, meret = 40 } = Astro.props;
---

<svg width={meret} height={meret} viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {
    nev === 'terv' && (
      <>
        <path d="M6 14l14-8 14 8v14l-14 8-14-8z" />
        <path d="M6 14l14 8 14-8M20 22v14" />
      </>
    )
  }
  {
    nev === 'szallitas' && (
      <>
        <path d="M3 10h22v18H3zM25 16h7l5 6v6H25z" />
        <circle cx="10" cy="30" r="3" />
        <circle cx="30" cy="30" r="3" />
      </>
    )
  }
  {nev === 'szereles' && <path d="M24 6a7 7 0 0 0-6 10L6 28l6 6 12-12a7 7 0 0 0 10-6l-4 4-5-1-1-5z" />}
  {
    nev === 'terkep' && (
      <>
        <path d="M20 37s12-11 12-20a12 12 0 0 0-24 0c0 9 12 20 12 20z" />
        <circle cx="20" cy="17" r="4" />
      </>
    )
  }
</svg>
