---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Szolgaltatasok from '../components/Szolgaltatasok.astro';
import Jelveny from '../components/Jelveny.astro';
import heroKep from '../assets/konyhak/silbermond/silbermond-eiche-nordic-anthrazit.jpg';
import studioKep from '../assets/konyhak/living/living-kombination-08.jpg';
import happyPlace from '../assets/logok/my-happy-place-fekete.png';
import studio from '../data/studio.json';

const kiemelt = (await getCollection('konyhak', (k) => k.data.fooldalon)).sort((a, b) => a.data.sorrend - b.data.sorrend);

const tenyek = [
  { nagy: '1963 óta', kicsi: 'osztrák családi vállalkozás' },
  { nagy: '1,4 millió+', kicsi: 'elkészült konyha' },
  { nagy: 'Made in Austria', kicsi: 'gyártás Felső-Ausztriában' },
  { nagy: '20+ szín', kicsi: 'front, 4 felülettel' },
];

const elonyok = [
  { cim: 'Osztrák minőség, 60+ év', szoveg: 'Felső-Ausztriában, Linzben gyártva, több mint 1,4 millió elkészült konyhával.' },
  { cim: 'Pontosan rád szabva', szoveg: 'Minden konyha egyedi méretre készül, 20+ frontszínből és 4 felületből választhatsz.' },
  { cim: 'Tartós anyagok', szoveg: 'FSC-tanúsított faanyag, karcálló frontok, víztaszító élzárás.' },
  { cim: 'Egy kézben minden', szoveg: 'A tervezéstől a beszerelésig a kaposvári csapat kísér végig.' },
];
---

<Layout
  title="Főoldal"
  description="DANKÜCHEN – Ausztria legtöbbet vásárolt konyhája, exkluzív stúdióban Kaposváron. Méretre szabott konyhák látványtervezéssel, kiszállítással és szereléssel."
  aktiv="fooldal"
>
  <section class="hero" aria-label="Bemutatkozás">
    <Image src={heroKep} alt="DANKÜCHEN Silbermond konyha Eiche Nordic és antracit frontokkal, szigettel" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" class="hero__kep" />
    <div class="tarolo hero__tartalom">
      <p class="hero__felirat">Exkluzív Stúdió Kaposvár</p>
      <h1>A konyhád.<br />A te helyed.</h1>
      <p class="hero__szoveg">DANKÜCHEN – Ausztria legtöbbet vásárolt konyhája, most exkluzív stúdióban Kaposváron.</p>
      <p class="hero__szlogen">Méretre szabott · egyedi · tartós</p>
      <div class="hero__gombok">
        <a href={url('/idopontfoglalas/')} class="gomb gomb--fo">Időpontot foglalok</a>
        <a href={url('/konyhak/')} class="gomb gomb--keret">Konyhák megtekintése</a>
      </div>
    </div>
  </section>

  <section class="tenyek" aria-label="Tények">
    <div class="tarolo tenyek__racs">
      {
        tenyek.map((t) => (
          <div class="teny">
            <span class="teny__nagy">{t.nagy}</span>
            <span class="teny__kicsi">{t.kicsi}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="szekcio" aria-labelledby="miert">
    <div class="tarolo miert">
      <div class="miert__bal">
        <Image src={happyPlace} alt="DANKÜCHEN – My happy place." width={300} />
        <h2 id="miert">Miért DANKÜCHEN?</h2>
        <p class="bevezeto">
          Egy konyha több, mint bútor: itt indul a reggel, itt találkozik a család, itt születnek a vasárnapi ebédek. A DANKÜCHEN 1963 óta
          azon dolgozik, hogy ez a hely a te happy place-ed legyen.
        </p>
      </div>
      <div class="miert__racs">
        {
          elonyok.map((e) => (
            <div class="elony">
              <h3>{e.cim}</h3>
              <p>{e.szoveg}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Szolgaltatasok />

  <section class="szekcio" aria-labelledby="stilus">
    <div class="tarolo stilus">
      <div class="stilus__fej">
        <div>
          <h2 id="stilus">Találd meg a stílusodat</h2>
          <p class="bevezeto">Minimalista, családi vagy vidéki: nyolc DAN-modell, számtalan szín- és anyagkombinációban.</p>
        </div>
        <a href={url('/konyhak/')} class="link-nyil">Összes konyha →</a>
      </div>
      <div class="stilus__racs">
        {
          kiemelt.map((k) => (
            <a href={url(`/konyhak/#${k.id}`)} class="kartya">
              <Image src={k.data.kep} alt={k.data.kepLeiras} widths={[400, 800]} sizes="(max-width: 640px) 100vw, 25vw" />
              <span class="kartya__nev">{k.data.nev}</span>
              <span class="kartya__alcim">{k.data.alcim}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="szekcio--panna" aria-labelledby="studio">
    <div class="studio">
      <Image src={studioKep} alt="DANKÜCHEN Living családi konyha nagy étkezőasztallal" widths={[700, 1200]} sizes="(max-width: 900px) 100vw, 50vw" class="studio__kep" />
      <div class="studio__szoveg">
        <Jelveny />
        <h2 id="studio">Gyere el, és nézd meg élőben</h2>
        <p class="bevezeto">
          Kaposvári bemutatótermünkben megfoghatod a frontokat, kipróbálhatod a fiókokat, és szakértőnkkel együtt kiválaszthatod a hozzád
          illő megoldást.
        </p>
        <p>
          {studio.cim}<br />{studio.nyitvatartas[0].napok} {studio.nyitvatartas[0].ido}
        </p>
        <a href={url('/idopontfoglalas/')} class="gomb gomb--fo">Időpontot foglalok</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: min(720px, 88vh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--dark-blueberry);
    color: var(--feher);
  }
  .hero__kep {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.42);
  }
  .hero__tartalom {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: 120px 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero__felirat {
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 820px;
    line-height: 1.02;
  }
  .hero__szoveg {
    font-size: 1.3125rem;
    line-height: 1.5;
    max-width: 600px;
  }
  .hero__szlogen {
    letter-spacing: 0.04em;
  }
  .hero__gombok {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
  }
  .hero .gomb--keret:hover {
    color: var(--feher);
  }

  .tenyek {
    background: var(--panna);
  }
  .tenyek__racs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    padding-block: 40px;
  }
  .teny {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .teny__nagy {
    font-family: var(--font-cim);
    font-style: italic;
    font-size: 2.25rem;
    line-height: 1.15;
  }
  .teny__kicsi {
    font-size: 0.9375rem;
    color: var(--szoveg-halvany);
  }

  .miert {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
  }
  .miert__bal {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .miert__bal img {
    width: 300px;
  }
  .miert__bal h2 {
    margin-top: 16px;
  }
  .miert__racs {
    flex: 1 1 520px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px 32px;
  }
  .elony {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--fekete);
    padding-top: 20px;
  }
  .elony h3 {
    font-family: var(--font-szoveg);
    font-style: normal;
    font-weight: 700;
    font-size: 1.1875rem;
  }
  .elony p {
    font-size: 1rem;
    color: var(--szoveg-halvany);
  }

  .stilus {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .stilus__fej {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-between;
    align-items: flex-end;
  }
  .stilus__fej > div {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 640px;
  }
  .stilus__racs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .kartya {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .kartya img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .kartya__nev {
    font-family: var(--font-cim);
    font-style: italic;
    font-size: 1.75rem;
  }
  .kartya__alcim {
    font-size: 0.9375rem;
    color: var(--szoveg-halvany);
  }

  .studio {
    max-width: var(--max);
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
  }
  .studio__kep {
    flex: 1 1 520px;
    min-width: 0;
    min-height: 480px;
    object-fit: cover;
  }
  .studio__szoveg {
    flex: 1 1 420px;
    min-width: 0;
    padding: 72px 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
    align-items: flex-start;
  }
  @media (max-width: 640px) {
    .studio__kep {
      min-height: 280px;
    }
    .studio__szoveg {
      padding: 48px 16px;
    }
  }
</style>
