# Az SQLite adatbázis helye. Fejlesztéskor elhagyható (alapérték: data/foglalasok.db a backend mappában).
DB_PATH=/var/lib/dankuchen/foglalasok.db
# A levelezőfiók jelszava. Ha nincs megadva, a foglalás működik, de nem megy ki levél.
SMTP_JELSZO=
# Az admin felület belépése. Mindkettőt a `node backend/admin-jelszo.ts` állítja elő (a szerveren be is írja),
# fejlesztéshez a `--kiir` kapcsolóval csak kiírja. Ha hiányzik, az admin nem érhető el.
ADMIN_FELHASZNALO=
ADMIN_JELSZO_HASH=
