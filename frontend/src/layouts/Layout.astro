---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../utils/url';
import { uzletAdat } from '../utils/studio';
import { WEBMCP_ORIGIN_TRIAL } from '../utils/webmcp';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import fontCim from '../assets/fonts/Gazpacho-MediumItalic.woff2?url';
import fontSzoveg from '../assets/fonts/GT-Walsheim-Regular.woff2?url';
import alapKep from '../assets/konyhak/silbermond/silbermond-eiche-nordic-anthrazit.jpg';
import logoKep from '../assets/logok/dankuchen-fekete.png';
import studio from '../../../shared/studio.json';

interface Props {
  title: string;
  description: string;
  aktiv?: 'fooldal' | 'konyhak' | 'dan-first' | 'kapcsolat' | 'idopont';
  // A link előnézetének képe (Facebook, Messenger, Viber stb.). Alapértelmezés a főoldal hero képe.
  kep?: ImageMetadata;
  kepLeiras?: string;
  // A keresők ne vegyék fel az oldalt (köszönőoldal, 404).
  noindex?: boolean;
  // Az oldal saját strukturált adatai (JSON-LD), a stúdió adatai mellé.
  strukturalt?: object[];
}

const {
  title,
  description,
  aktiv,
  kep = alapKep,
  kepLeiras = 'DANKÜCHEN Silbermond konyha Eiche Nordic és antracit frontokkal, szigettel',
  noindex = false,
  strukturalt = [],
} = Astro.props;
const teljesCim = title === 'Főoldal' ? 'DANKÜCHEN Exkluzív Stúdió Kaposvár' : `${title} – DANKÜCHEN Kaposvár`;

const teljesUrl = (ut: string) => new URL(ut, Astro.site).href;
const oldalUrl = teljesUrl(Astro.url.pathname);
const megosztas = await getImage({ src: kep, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const logo = await getImage({ src: logoKep, width: 600, format: 'png' });
const adatok = [uzletAdat({ honlap: teljesUrl(url('/')), kep: teljesUrl(megosztas.src), logo: teljesUrl(logo.src) }), ...strukturalt];
// A "<" kódolva, hogy a szövegből ne zárulhasson le idő előtt a script elem.
const jsonLd = JSON.stringify(adatok.length === 1 ? adatok[0] : adatok).replace(/</g, '\\u003c');

// Márkafontok (lásd README). A fájlnevükbe a build hash-t tesz, így hosszan gyorsítótárazhatók.
const fontFace = `
@font-face {
  font-family: 'Gazpacho';
  src: url('${fontCim}') format('woff2');
  font-style: italic;
  font-weight: 500;
  font-display: swap;
}
@font-face {
  font-family: 'GT Walsheim';
  src: url('${fontSzoveg}') format('woff2');
  font-weight: 400;
  font-display: swap;
}`;
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- WebMCP: az időpontfoglalás eszközei az AI-agenteknek (utils/webmcp.ts) -->
    <meta http-equiv="origin-trial" content={WEBMCP_ORIGIN_TRIAL} />
    <title>{teljesCim}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={oldalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.nev} />
    <meta property="og:title" content={teljesCim} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={oldalUrl} />
    <meta property="og:image" content={teljesUrl(megosztas.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={kepLeiras} />
    <meta property="og:locale" content="hu_HU" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" type="image/png" href={url('/favicon.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={fontSzoveg} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontCim} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
  </head>
  <body>
    <a class="sr-only" href="#tartalom">Ugrás a tartalomra</a>
    <Header aktiv={aktiv} />
    <main id="tartalom">
      <slot />
    </main>
    <Footer />
  </body>
</html>
