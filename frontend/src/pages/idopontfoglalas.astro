---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroKep from '../assets/konyhak/amica/amica-eiche-nordic-fjord-grun.jpg';
import studio from '../../../shared/studio.json';
import { nemzetkoziTelefon } from '../utils/studio';

const tel = nemzetkoziTelefon();

const lepesek = [
  { cim: 'Időpontfoglalás', szoveg: 'Kiválasztod a neked megfelelő napot és órát.' },
  { cim: 'Tervezés', szoveg: 'A bemutatóteremben megtervezzük és 3D-ben megmutatjuk a konyhát.' },
  { cim: 'Felmérés és ajánlat', szoveg: 'Kimegyünk felmérni, és részletes, átlátható ajánlatot adunk.' },
  { cim: 'Gyártás, kiszállítás, szerelés', szoveg: 'Ausztriában legyártjuk, házhoz szállítjuk és beszereljük.' },
];
---

<Layout
  title="Időpontfoglalás"
  description="Foglalj időpontot látványtervezésre a DANKÜCHEN kaposvári exkluzív stúdiójában. 3D-s látványterv a te méreteid alapján, kötöttségek nélkül."
  aktiv="idopont"
  kep={heroKep}
  kepLeiras="DANKÜCHEN Amica konyha Eiche Nordic és fjordzöld frontokkal"
>
  <section class="hero" aria-labelledby="cim">
    <Image src={heroKep} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="hero__kep" />
    <div class="tarolo hero__tartalom">
      <p class="hero__felirat">Látványtervezés</p>
      <h1 id="cim">Foglalj időpontot látványtervezésre</h1>
      <p class="hero__szoveg">Egy óra, kötöttségek nélkül: elmondod, hogyan használod a konyhát, mi pedig 3D-ben megmutatjuk, hogyan nézhet ki.</p>
    </div>
  </section>

  <section class="szekcio" aria-label="Foglalás">
    <div class="tarolo foglalas">
      <form class="urlap" data-szabad={url('/api/szabad-idopontok')} data-foglalas={url('/api/foglalas')} data-koszonjuk={url('/koszonjuk/')}>
        <h2>Időpontfoglalás</h2>
        <noscript class="teljes">
          <p class="urlap__hiba">Az online foglaláshoz JavaScript szükséges. Hívj minket: <a href={`tel:${tel}`}>{studio.telefon}</a></p>
        </noscript>
        <input type="text" name="_gotcha" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>Név *<input type="text" name="nev" required autocomplete="name" /></label>
        <label>Telefon *<input type="tel" name="telefon" required autocomplete="tel" placeholder="+36 …" /></label>
        <label>E-mail *<input type="email" name="email" required autocomplete="email" /></label>
        <label>Település<input type="text" name="telepules" autocomplete="address-level2" /></label>
        <label
          >Dátum *
          <span class="napmezo">
            <select name="nap" required disabled>
              <option value="">Betöltés…</option>
            </select>
          </span>
        </label>
        <label
          >Óra *
          <select name="ora" required disabled>
            <option value="">Előbb válassz napot</option>
          </select>
        </label>
        <label class="teljes"
          >Üzenet
          <textarea name="uzenet" rows="5" placeholder="Pl. a konyha mérete, mikorra szeretnéd, különleges kérések…"></textarea>
        </label>
        <label class="teljes jelolo">
          <input type="checkbox" name="adatkezeles" value="elfogadva" required />
          <span>Elolvastam és elfogadom az <a href={url('/adatkezeles/')}>adatkezelési tájékoztatót</a>. *</span>
        </label>
        <p class="urlap__hiba teljes" role="alert" hidden>
          <span></span> Telefonon is segítünk: <a href={`tel:${tel}`}>{studio.telefon}</a>
        </p>
        <button type="submit" class="gomb gomb--fo teljes" disabled>Időpontot foglalok</button>
      </form>

      <aside class="hozd">
        <h2>Mit hozz magaddal?</h2>
        <ul>
          {studio.mitHozzMagaddal.map((t) => <li>{t}</li>)}
        </ul>
        <div class="hozd__tel">
          <strong>Inkább telefonálnál?</strong>
          <a href={`tel:${tel}`}>{studio.telefon}</a>
          <span>{studio.nyitvatartas[0].napok} {studio.nyitvatartas[0].ido}</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="szekcio szekcio--panna" aria-labelledby="folyamat">
    <div class="tarolo folyamat">
      <h2 id="folyamat">Így lesz meg a konyhád</h2>
      <ol>
        {
          lepesek.map((l, i) => (
            <li>
              <span class="folyamat__szam">{i + 1}</span>
              <h3>{l.cim}</h3>
              <p>{l.szoveg}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<script>
  import { alapertelmezettNap, napFelirat, oraFelirat } from '../../../shared/idopontok.ts';

  const urlap = document.querySelector<HTMLFormElement>('form.urlap')!;
  const napMezo = urlap.querySelector<HTMLSelectElement>('select[name="nap"]')!;
  const oraMezo = urlap.querySelector<HTMLSelectElement>('select[name="ora"]')!;
  const hiba = urlap.querySelector<HTMLElement>('.urlap__hiba')!;
  const gomb = urlap.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const GOMB_FELIRAT = gomb.textContent!;

  const UZENETEK: Record<string, string> = {
    foglalt: 'Ezt az órát közben lefoglalták, válassz másikat.',
    idopont: 'Ez az időpont már nem foglalható, válassz másikat.',
    'tul-sok-foglalas': 'Ezzel az e-mail címmel vagy telefonszámmal már több élő foglalásod van.',
    'tul-sok-keres': 'Túl sok próbálkozás. Kérjük, próbáld újra néhány perc múlva.',
    adat: 'Kérjük, ellenőrizd a megadott adatokat.',
  };

  let napok: Record<string, string[]> = {};
  let hosszPerc = 60;

  function hibaMutatasa(szoveg: string) {
    hiba.querySelector('span')!.textContent = szoveg;
    hiba.hidden = false;
  }

  function orakFrissitese() {
    const orak = napok[napMezo.value] ?? [];
    const korabbi = oraMezo.value;
    oraMezo.replaceChildren(
      new Option(napMezo.value ? 'Válassz órát' : 'Előbb válassz napot', ''),
      ...orak.map((o) => new Option(oraFelirat(o, hosszPerc), o)),
    );
    oraMezo.disabled = orak.length === 0;
    if (orak.includes(korabbi)) oraMezo.value = korabbi;
  }

  async function szabadIdopontokBetoltese() {
    const korabbi = napMezo.value;
    try {
      const valasz = await fetch(urlap.dataset.szabad!, { headers: { Accept: 'application/json' } });
      if (!valasz.ok) throw new Error(`Szabad időpontok: ${valasz.status}`);
      ({ napok, hosszPerc } = await valasz.json());
    } catch (err) {
      console.error(err);
      napok = {};
      hibaMutatasa('Most nem tudjuk betölteni a szabad időpontokat.');
    }
    const lista = Object.keys(napok);
    napMezo.replaceChildren(...(lista.length ? lista.map((n) => new Option(napFelirat(n), n)) : [new Option('Nincs szabad időpont', '')]));
    napMezo.disabled = lista.length === 0;
    gomb.disabled = lista.length === 0;
    if (lista.length > 0) napMezo.value = lista.includes(korabbi) ? korabbi : alapertelmezettNap(lista, new Date());
    orakFrissitese();
  }

  napMezo.addEventListener('change', orakFrissitese);

  // A natív lenyíló magassága nem korlátozható, és a sok nap nem fér el a képernyőn. Egérrel kezelt eszközön
  // ezért nyitáskor 7 soros listává alakul a mező. Telefonon a rendszer saját választója nyílik meg.
  if (matchMedia('(pointer: fine)').matches) {
    let nyitaskoriNap = '';
    let nyitoKattintas = false;
    const nyitva = () => napMezo.hasAttribute('size');
    const nyit = () => {
      nyitaskoriNap = napMezo.value;
      napMezo.size = 7;
    };
    const zar = () => napMezo.removeAttribute('size');

    napMezo.addEventListener('mousedown', (e) => {
      if (nyitva()) {
        nyitoKattintas = false;
      } else if (e.button === 0) {
        e.preventDefault();
        napMezo.focus();
        nyit();
        nyitoKattintas = true;
      }
    });
    napMezo.addEventListener('click', (e) => {
      // A nyitó kattintás felengedése még ugyanide esik. A görgetősávra kattintás nyitva hagyja a listát.
      const sorra = e.clientX - napMezo.getBoundingClientRect().left <= napMezo.clientWidth;
      if (!nyitoKattintas && nyitva() && sorra) zar();
      nyitoKattintas = false;
    });
    napMezo.addEventListener('blur', zar);
    document.addEventListener('mousedown', (e) => {
      if (!napMezo.contains(e.target as Node)) zar();
    });
    napMezo.addEventListener('keydown', (e) => {
      if (!nyitva()) {
        if (e.key === ' ' || e.key === 'Enter' || e.key === 'F4' || (e.altKey && e.key.startsWith('Arrow'))) {
          e.preventDefault();
          nyit();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        napMezo.value = nyitaskoriNap;
        orakFrissitese();
        zar();
      } else if (e.key === ' ' || e.key === 'Enter') {
        e.preventDefault();
        zar();
      } else if (e.key === 'Tab') {
        zar();
      }
    });
  }

  urlap.addEventListener('submit', async (e) => {
    e.preventDefault();
    hiba.hidden = true;
    gomb.disabled = true;
    gomb.textContent = 'Küldés…';
    try {
      const valasz = await fetch(urlap.dataset.foglalas!, {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(new FormData(urlap))),
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      });
      if (valasz.ok) {
        location.href = urlap.dataset.koszonjuk!;
        return;
      }
      const { hiba: kod } = await valasz.json().catch(() => ({ hiba: '' }));
      hibaMutatasa(UZENETEK[kod] ?? 'Nem sikerült elküldeni a foglalást. Próbáld újra.');
      if (kod === 'foglalt' || kod === 'idopont') await szabadIdopontokBetoltese();
    } catch (err) {
      console.error(err);
      hibaMutatasa('Nem sikerült elküldeni a foglalást. Próbáld újra.');
    }
    gomb.disabled = false;
    gomb.textContent = GOMB_FELIRAT;
  });

  // A vissza gombbal gyorsítótárból visszatérve is friss lista kell, és a gomb se maradjon „Küldés…”.
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    gomb.textContent = GOMB_FELIRAT;
    szabadIdopontokBetoltese();
  });

  szabadIdopontokBetoltese();
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--dark-blueberry);
    color: var(--feher);
  }
  .hero__kep {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A kép teteje minden szélességen ugyanott vágódik: a falképen lévő alak homlokánál, a kép magasságának 32%-ánál.
     A kép 4:3-as, a magassága 75vw, ennek a 32%-a a 24vw. Más képnél ezt újra be kell állítani.
     Keskenyebb ablakban a vágás alatt nem maradna elég kép a hero kitöltéséhez, ezért ott középre igazított marad. */
  @media (min-width: 1100px) {
    .hero__kep {
      object-position: 50% -24vw;
    }
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.5);
  }
  .hero__tartalom {
    position: relative;
    z-index: 1;
    padding-block: 120px 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hero__felirat {
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero h1 {
    max-width: 860px;
    font-size: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__szoveg {
    font-size: 1.25rem;
    max-width: 640px;
  }

  .foglalas {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
  }
  .urlap {
    flex: 1 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  .urlap h2 {
    grid-column: 1 / -1;
    font-size: 2.5rem;
    margin-bottom: 8px;
  }
  .urlap label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .urlap .teljes {
    grid-column: 1 / -1;
  }
  .urlap input:not([type='checkbox']),
  .urlap select,
  .urlap textarea {
    min-height: 52px;
    padding: 0 16px;
    border: 1.5px solid #8a837b;
    border-radius: 2px;
    background: var(--feher);
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    color: var(--fekete);
  }
  /* Lenyitva a lista a mező helyén, a többi mező fölött jelenik meg, így semmi nem mozdul el. */
  .napmezo {
    position: relative;
    display: block;
    min-height: 52px;
  }
  .napmezo select {
    width: 100%;
  }
  /* A leghosszabb dátumnak a legkeskenyebb, 240 pixeles oszlopban is el kell férnie a görgetősáv mellett. */
  .urlap .napmezo select[size] {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    padding: 2px;
    font-size: 0.9375rem;
    box-shadow: 0 6px 18px rgb(0 0 0 / 18%);
  }
  /* A sorokat a script hozza létre, ezért nem kapják meg az Astro hatókör-jelölését. */
  .napmezo select[size] :global(option) {
    padding: 6px;
  }
  .urlap textarea {
    padding-block: 14px;
    resize: vertical;
  }
  .urlap .jelolo {
    flex-direction: row;
    align-items: flex-start;
    gap: 12px;
    font-weight: 400;
    line-height: 1.5;
  }
  .jelolo input {
    width: 22px;
    height: 22px;
    margin: 1px 0 0;
    flex: none;
  }
  .urlap button {
    justify-self: start;
    min-height: 56px;
    padding: 0 36px;
    font-size: 1.0625rem;
  }
  .urlap button:disabled,
  .urlap select:disabled {
    opacity: 0.6;
  }
  .urlap__hiba {
    color: var(--tamarillo);
    font-weight: 700;
  }

  .hozd {
    flex: 1 1 360px;
    min-width: 0;
    background: var(--panna);
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hozd h2 {
    font-size: 2rem;
  }
  .hozd ul {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .hozd__tel {
    border-top: 1px solid var(--tahini);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.9375rem;
  }
  .hozd__tel a {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .folyamat {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .folyamat ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 32px;
  }
  .folyamat li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 2px solid var(--fekete);
    padding-top: 20px;
  }
  .folyamat__szam {
    font-family: var(--font-cim);
    font-style: italic;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--tamarillo);
  }
  .folyamat h3 {
    font-family: var(--font-szoveg);
    font-style: normal;
    font-weight: 700;
    font-size: 1.1875rem;
  }
  .folyamat p {
    color: var(--szoveg);
  }
</style>
