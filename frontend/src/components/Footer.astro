---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import logoFeher from '../assets/logok/dankuchen-feher.png';
import lamelloLogo from '../assets/logok/lamello.png';
import studio from '../../../shared/studio.json';
import { nemzetkoziTelefon } from '../utils/studio';

const ev = new Date().getFullYear();
const tel = nemzetkoziTelefon();
---

<footer class="lablec">
  <div class="lablec__studio">
    <div class="tarolo lablec__studio-sor">
      <div class="lablec__marka">
        <Image src={logoFeher} alt="DANKÜCHEN" width={260} />
        <span>Exkluzív Stúdió Kaposvár</span>
      </div>
      <p class="lablec__szlogen">Akkor vagyunk elégedettek, <br>ha te is az vagy.</p>
    </div>
  </div>
  <div class="lablec__also">
    <div class="tarolo lablec__racs">
      <div>
        <h2>Bemutatóterem</h2>
        <p>{studio.cim}</p>
        {studio.nyitvatartas.map((n) => <p>{n.napok}: {n.ido}</p>)}
      </div>
      <div>
        <h2>Elérhetőség</h2>
        <p><a href={`tel:${tel}`}>{studio.telefon}</a></p>
        <p><a href={`mailto:${studio.email}`}>{studio.email}</a></p>
      </div>
      <nav aria-label="Lábléc navigáció">
        <h2>Oldalak</h2>
        <p><a href={url('/')}>Főoldal</a></p>
        <p><a href={url('/konyhak/')}>Konyhák</a></p>
        <p><a href={url('/dan-first/')}>DAN FIRST</a></p>
        <p><a href={url('/kapcsolat/')}>Kapcsolat</a></p>
        <p><a href={url('/idopontfoglalas/')}>Időpontfoglalás</a></p>
      </nav>
      <div>
        
        <Image src={lamelloLogo} alt="Lamelló" width={128} />
        
      </div>
    </div>
    <div class="tarolo lablec__jogi">
      <!--
      <span>© {ev} {studio.uzemelteto} · Cg. {studio.cegjegyzekszam} · Adószám: {studio.adoszam}</span>
       -->
      <span>© {ev} {studio.uzemelteto}</span>
      <ul class="lablec__kozossegi">
        {
          studio.kozossegi.map((k) => (
            <li>
              <a href={k.url} aria-label={k.nev}>
                {/* Feather Icons (MIT) */}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {k.nev === 'Facebook' && <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />}
                  {k.nev === 'Instagram' && (
                    <>
                      <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                    </>
                  )}
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .lablec__studio {
    background: var(--tamarillo);
    color: var(--feher);
  }
  .lablec__studio-sor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 40px;
  }
  .lablec__marka {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lablec__marka img {
    width: 260px;
  }
  .lablec__szlogen {
    font-family: var(--font-cim);
    font-style: italic;
    font-size: 1.625rem;
    line-height: 1.25;
    max-width: 32rem;
  }
  .lablec__also {
    background: var(--panna);
  }
  .lablec__racs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
    padding-block: 56px 32px;
    font-size: 0.9375rem;
  }
  .lablec__racs > * {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .lablec__racs h2 {
    font-family: var(--font-szoveg);
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .lablec__racs a {
    text-decoration: none;
  }
  .lablec__racs img {
    width: 128px;
  }
  /* Balra a copyright, jobbra a közösségi ikonok, egy sorban. */
  .lablec__jogi {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid #cfc7bc;
    padding-block: 20px 32px;
    font-size: 0.8125rem;
    color: var(--szoveg-halvany);
  }
  .lablec__kozossegi {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lablec__kozossegi a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    color: var(--szoveg);
    transition:
      background-color 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .lablec__kozossegi a:hover {
    background: var(--tamarillo);
    border-color: var(--tamarillo);
    color: var(--feher);
  }
  .lablec__kozossegi svg {
    width: 20px;
    height: 20px;
  }
</style>
